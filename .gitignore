# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Entornos virtuales
.venv/
venv/
env/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Herramientas
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Datos (se conserva la estructura de carpetas con .gitkeep)
#   data/raw/        crudo de la API, ~1 GB  (secop2_contratos, secop2_modificaciones)
#   data/interim/    resultados intermedios
#   data/processed/  Parquet del modelo para Power BI, ~92 MB
#   data/*.duckdb    base analítica, ~2,5 GB
#   data/*.log       registros de las descargas
# Todo se regenera con los scripts (ver README).
data/**
!data/**/
!data/**/.gitkeep

# Red de seguridad: archivos de datos fuera de data/
*.parquet
*.jsonl.gz
*.csv.gz
*.log

# Informes generados
reports/figures/*
!reports/figures/.gitkeep

# Sistema operativo / editores
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Bases de datos locales
*.duckdb
*.duckdb.wal

# Power BI: caché con datos y configuración local del proyecto PBIP
**/.pbi/localSettings.json
**/.pbi/cache.abf
*.pbix
